From: Christoph Reiter <reiter.christoph@gmail.com>
Date: Thu, 5 Sep 2024 21:37:31 +0200
Subject: tests: adjust for g-i _GI_TEST_EXTERN macro rename

Switch from _GI_TEST_EXTERN to GI_TEST_EXTERN like upstream.
To still support the old g-i test files we continue to set
_GI_EXTERN for building and add a fallback for GI_TEST_EXTERN
in the code for the old scanner.
---
 tests/gimarshallingtestsextra.h | 28 ++++++++++-------
 tests/meson.build               |  4 ++-
 tests/regressextra.h            | 70 ++++++++++++++++++++++-------------------
 3 files changed, 56 insertions(+), 46 deletions(-)

diff --git a/tests/gimarshallingtestsextra.h b/tests/gimarshallingtestsextra.h
index 8feecaa..8873d88 100644
--- a/tests/gimarshallingtestsextra.h
+++ b/tests/gimarshallingtestsextra.h
@@ -22,6 +22,10 @@
 #include <glib-object.h>
 #include <gitestmacros.h>
 
+#ifndef GI_TEST_EXTERN
+#define GI_TEST_EXTERN extern
+#endif
+
 typedef enum
 {
   GI_MARSHALLING_TESTS_EXTRA_ENUM_VALUE1,
@@ -37,36 +41,36 @@ typedef enum
 } GIMarshallingTestsExtraFlags;
 
 
-_GI_TEST_EXTERN
+GI_TEST_EXTERN
 GType gi_marshalling_tests_extra_flags_get_type (void) G_GNUC_CONST;
 #define GI_MARSHALLING_TESTS_TYPE_EXTRA_FLAGS (gi_marshalling_tests_extra_flags_get_type ())
 
-_GI_TEST_EXTERN
