-_GI_TEST_EXTERN
+GI_TEST_EXTERN
 gchar * gi_marshalling_tests_filename_copy (gchar *path_in);
-_GI_TEST_EXTERN
+GI_TEST_EXTERN
 gboolean gi_marshalling_tests_filename_exists (gchar *path);
-_GI_TEST_EXTERN
+GI_TEST_EXTERN
 gchar * gi_marshalling_tests_filename_to_glib_repr (gchar *path_in, gsize *len);
 
-_GI_TEST_EXTERN
+GI_TEST_EXTERN
